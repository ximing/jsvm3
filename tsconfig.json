{
  "compilerOptions": {
    "target": "ES5",
    "module": "commonjs",
    "declaration": true,
    "removeComments": false,
    "preserveConstEnums": false,
    "moduleResolution": "node",
    "experimentalDecorators": true,
    "noImplicitAny": false,
    "allowSyntheticDefaultImports": true,
    "outDir": "lib",
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "strictNullChecks": true,
    "resolveJsonModule": true,
    "sourceMap": true,
    "lib": ["es2015"],
    "baseUrl": ".",
    "paths": {
      "jsvm3/runtime": ["src/index.ts"],
      "jsvm3/compiler": ["src/compiler/index.ts"],
      "jsvm3/artifact": ["src/artifact/index.ts"],
      "jsvm3/full": ["src/full/index.ts"],
      "jsvm3/exp": ["src/exp.ts"]
    }
  },
  "include": [
    "src"
  ],
  "exclude": ["__tests__", "node_modules", "lib", "tests", "jest"],
  "compileOnSave": false
}
